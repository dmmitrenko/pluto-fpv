- name: carrier_loop_limits
  id: snippet
  parameters:
    alias: ''
    code: '# Keep the carrier loops inside the expected frequency offset range.

      # Without the limits they wander over noise while the signal is absent,

      # get stuck at the far end of their range and the link does not recover.

      import math

      limit = 2 * math.pi * self.max_freq_offset_hz / self.samp_rate

      self.carrier_coarse.set_max_freq(limit)

      self.carrier_coarse.set_min_freq(-limit)

      self.carrier_fine.set_max_freq(0.5)

      self.carrier_fine.set_min_freq(-0.5)

      '
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1032, 1360.0]
    rotation: 0
    state: enabled
