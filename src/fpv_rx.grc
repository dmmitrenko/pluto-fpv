- name: link_monitor
  id: snippet
  parameters:
    alias: ''
    code: "# Writes the settings and, once per log period, the state of the link to\n\
      # rx.log. The values are only read from the blocks, nothing is changed.\nimport\
      \ logging\nimport math\nimport threading\nimport time\n\nimport numpy as np\n\
      \n# Snapshots of the signal taken from the probes during one log period.\nSNAPSHOTS\
      \ = 10\n# Full scale of the radio is 1.0. A sample this close to it counts as\
      \ clipped.\nCLIP_LEVEL = 0.98\n# Written when there was nothing to measure.\n\
      NO_SIGNAL_DB = -200.0\n\nlog = logging.getLogger(\"fpv_rx\")\nlog.info(\n  \
      \  \"settings: center_freq=%d samp_rate=%d sps=%d excess_bw=%.2f ts_per_frame=%d\
      \ \"\n    \"fec_enabled=%d fec_k=%d fec_polys=%s pluto_uri=%s rf_bandwidth=%d\
      \ rx_gain=%.0f \"\n    \"max_freq_offset_hz=%.0f log_period_s=%.1f\",\n    self.center_freq,\
      \ self.samp_rate, self.sps, self.excess_bw, self.ts_per_frame,\n    self.fec_enabled,\
      \ self.fec_k, self.fec_polys, self.pluto_uri, self.rf_bandwidth,\n    self.rx_gain_slider,\
      \ self.max_freq_offset_hz, self.log_period_s,\n)\n\ndef to_db(ratio):\n    return\
      \ 10 * math.log10(ratio) if ratio > 0 and math.isfinite(ratio) else NO_SIGNAL_DB\n\
      \ndef report_loop():\n    depacketizer = self.depacketizer\n    totals = depacketizer.get_totals()\n\
      \    samples = self.pluto_rx.nitems_written(0)\n    last_time = time.monotonic()\n\
      \    while True:\n        measured = clipped = 0\n        power = peak = ideal_power\
      \ = error_power = 0.0\n        for _ in range(SNAPSHOTS):\n            # stopped\
      \ is set when the flow graph stops, which ends this thread.\n            if\
      \ depacketizer.stopped.wait(self.log_period_s / SNAPSHOTS):\n              \
      \  return\n            # Signal as it comes from the radio.\n            data\
      \ = np.array(self.rx_input_probe.level())\n            largest = np.maximum(np.abs(data.real),\
      \ np.abs(data.imag))\n            measured += len(data)\n            power +=\
      \ float(np.vdot(data, data).real)\n            peak = max(peak, float(largest.max()))\n\
      \            clipped += int(np.count_nonzero(largest >= CLIP_LEVEL))\n     \
      \       # Recovered symbols against the four QPSK points, which lie on the\n\
      \            # diagonals at the mean amplitude.\n            symbols = np.array(self.rx_symbol_probe.level())\n\
      \            amplitude = float(np.mean(np.abs(symbols)))\n            points\
      \ = (np.sign(symbols.real) + 1j * np.sign(symbols.imag)) * amplitude / math.sqrt(2)\n\
      \            ideal_power += amplitude * amplitude * len(symbols)\n         \
      \   error_power += float(np.vdot(symbols - points, symbols - points).real)\n\
      \n        now = time.monotonic()\n        elapsed = now - last_time\n      \
      \  last_time = now\n        previous, previous_samples = totals, samples\n \
      \       totals = depacketizer.get_totals()\n        samples = self.pluto_rx.nitems_written(0)\n\
      \        # The loops report the correction they apply. The coarse loop runs\
      \ at\n        # the sample rate and with the opposite sign, the fine loop at\
      \ the\n        # symbol rate. Their sum is the frequency offset of the transmitter.\n\
      \        symbol_rate = self.samp_rate / float(self.sps)\n        coarse_hz =\
      \ -self.carrier_coarse.get_frequency() * self.samp_rate / (2 * math.pi)\n  \
      \      fine_hz = self.carrier_fine.get_frequency() * symbol_rate / (2 * math.pi)\n\
      \        log.info(\n            \"status: sync=%d samples=%.3f level_dbfs=%.1f\
      \ peak=%.2f clipped=%.2f%% \"\n            \"rx_gain=%.0f agc_gain=%.1f freq_offset_hz=%.0f\
      \ coarse_hz=%.0f fine_hz=%.0f \"\n            \"clock_rate=%.5f mer_db=%.1f\
      \ frames=%d lost=%d crc_errors=%d sync_hits=%d \"\n            \"kbit=%.0f\"\
      ,\n            depacketizer.get_sync(),\n            (samples - previous_samples)\
      \ / (elapsed * self.samp_rate),\n            to_db(power / measured), peak,\
      \ 100.0 * clipped / measured,\n            self.rx_gain_slider, self.agc.gain(),\n\
      \            coarse_hz + fine_hz, coarse_hz, fine_hz,\n            self.clock_sync.clock_rate(),\n\
      \            to_db(ideal_power / error_power) if error_power > 0 else NO_SIGNAL_DB,\n\
      \            totals[\"received\"] - previous[\"received\"],\n            totals[\"\
      lost\"] - previous[\"lost\"],\n            totals[\"crc_errors\"] - previous[\"\
      crc_errors\"],\n            totals[\"sync_hits\"] - previous[\"sync_hits\"],\n\
      \            depacketizer.get_bitrate_kbps(),\n        )\n\nif self.log_period_s\
      \ > 0:\n    threading.Thread(target=report_loop, daemon=True).start()\n"
    comment: ''
    priority: '0'
    section: main_after_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1032, 1464.0]
    rotation: 0
    state: enabled
